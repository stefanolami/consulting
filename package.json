{
	"name": "time-and-place-consulting",
	"version": "2.0.0",
	"private": true,
	"engines": {
		"node": ">=24 <27"
	},
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint . --max-warnings=0",
		"lint:fix": "eslint . --fix",
		"typecheck": "tsc --noEmit",
		"test": "node --test scripts/*.test.mjs",
		"auth:bootstrap-admin": "node --env-file=.env.local scripts/bootstrap-admin.mjs",
		"outreach:bootstrap": "node --env-file=.env.local scripts/bootstrap-outreach.mjs",
		"check": "npm run lint && npm run typecheck && npm run test && npm run build"
	},
	"dependencies": {
		"@radix-ui/react-checkbox": "1.3.11",
		"@radix-ui/react-dropdown-menu": "2.1.24",
		"@radix-ui/react-label": "2.1.15",
		"@radix-ui/react-slot": "1.3.3",
		"@supabase/ssr": "0.12.4",
		"@supabase/supabase-js": "2.111.0",
		"@tiptap/extension-link": "^3.20.0",
		"@tiptap/react": "^3.20.0",
		"@tiptap/starter-kit": "^3.20.0",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"d3-geo": "3.1.1",
		"i18n-iso-countries": "7.14.0",
		"lucide-react": "1.27.0",
		"next": "16.2.12",
		"next-intl": "4.13.4",
		"next-themes": "0.4.6",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"tailwind-merge": "3.6.0",
		"topojson-client": "3.1.0",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "4.3.3",
		"@types/d3-geo": "3.1.1",
		"@types/node": "24.13.3",
		"@types/react": "19.2.17",
		"@types/react-dom": "19.2.3",
		"@types/topojson-client": "3.1.5",
		"brace-expansion": "1.1.17",
		"eslint": "9.39.5",
		"eslint-config-next": "16.2.12",
		"postcss": "8.5.24",
		"tailwindcss": "4.3.3",
		"tw-animate-css": "1.4.0",
		"typescript": "5.9.3"
	},
	"overrides": {
		"eslint": {
			"brace-expansion": "1.1.17"
		},
		"flatted@<=3.4.1": "3.4.3",
		"picomatch@>=4.0.0 <4.0.4": "4.0.5",
		"postcss": "$postcss",
		"next": {
			"sharp": "0.35.3"
		}
	}
