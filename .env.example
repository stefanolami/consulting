NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only. Required later for trusted Auth Admin operations such as invites.
# Never expose this value through a NEXT_PUBLIC_* variable.
SUPABASE_SECRET_KEY=your-secret-key

# Local-only walkthrough of the in-progress admin UI. Never enable in a
# production deployment; this is also blocked automatically outside `next dev`.
ADMIN_DEMO_MODE=false

# Contact form (server-only; see README "Contact form"). Never use a
# NEXT_PUBLIC_ prefix for these.
CONTACT_SMTP_HOST=
CONTACT_SMTP_PORT=
CONTACT_SMTP_USER=
CONTACT_SMTP_PASSWORD=
CONTACT_TO_EMAIL=
# At least 32 random characters; required in production.
CONTACT_FORM_SECRET=
# Development only: set to "json" to log messages instead of sending them.
CONTACT_MAIL_TRANSPORT=
